            },
            {
              "id": "b95a53e9-828d-58cc-9c0f-e3d9a47e3afe",
              "name": "actorInput",
              "value": "{\"queries\": [\"phone case\"], \"maxItems\": 30, \"detailLevel\": \"full\", \"proxyConfiguration\": {\"useApifyProxy\": true}}",
